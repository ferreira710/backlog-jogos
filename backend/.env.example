# Copie para .env e ajuste conforme necessario.

APP_NAME="API CRUD"
DATABASE_URL="sqlite:///./app.db"

# Loga todo o SQL emitido — util para depurar, ruidoso em producao.
SQL_ECHO=false

# Origens permitidas pelo CORS (separadas por virgula).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Chave gratuita em https://rawg.io/apidocs — habilita a busca de capas
# ao criar/editar um jogo. Sem ela, o endpoint de busca externa responde 503.
RAWG_API_KEY=""
